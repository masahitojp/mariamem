 // memFile is an open handle into a MemFS node.
 type memFile struct {
+	writable bool
 	fsys   *MemFS
 	node   *memNode
 	off    int64
 	dirOff int
 }
 
+// Allocate grows under the same node lock as WriteAt and Truncate. It never
+// changes the handle position and never shrinks data, including mapped backing.
+func (f *memFile) Allocate(end int64) error {
+ f.fsys.mu.Lock()
+ defer f.fsys.mu.Unlock()
+ if !f.writable { return syscall.EBADF }
+ if f.node.dir { return syscall.EISDIR }
+ if end > int64(len(f.node.data)) {
+  allocation := make([]byte, end)
+  copy(allocation, f.node.data)
+  f.node.data = allocation
+  f.node.modTime = time.Now()
+ }
+ return nil
+}
+
+// Native logical growth is serialized with every native WASI write/resize/open.
+// This is not a storage-reservation or foreign-process coordination guarantee.
+var nativeFileResizeMu sync.Mutex
+func lockNativeFileResize(f File) func() {
+ if _, ok := f.(*os.File); ok {
+  nativeFileResizeMu.Lock()
+  return nativeFileResizeMu.Unlock
+ }
+ return func() {}
+}
