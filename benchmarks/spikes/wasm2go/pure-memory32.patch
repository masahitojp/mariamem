+package codegen
+
+import "testing"
+
+func TestMemoryAccessWidths(t *testing.T) {
+	for typ, want := range map[string]uint64{"uint8": 1, "int8": 1, "uint16": 2, "int16": 2, "uint32": 4, "int32": 4, "float32": 4, "uint64": 8, "int64": 8, "float64": 8} {
+		if got := (memOpSpec{elemType: typ}).accessWidth(); got != want {
+			t.Fatalf("%s: %d != %d", typ, got, want)
+		}
+	}
+}
