+package pass
+
+import (
+	"github.com/goccy/wasm2go/internal/ssa"
+	"testing"
+)
+
+func TestDCEKeepsTrappingLoad(t *testing.T) {
+	addr := &ssa.Value{ID: 1, Op: ssa.OpConst32, Type: ssa.TypeI32}
+	load := &ssa.Value{ID: 2, Op: ssa.OpLoad32, Type: ssa.TypeI32, Args: []*ssa.Value{addr}, MemoryMayTrap: true}
+	dead := &ssa.Value{ID: 3, Op: ssa.OpConst32, Type: ssa.TypeI32}
+	f := &ssa.Func{Blocks: []*ssa.Block{{Kind: ssa.BlockPlain, Values: []*ssa.Value{addr, load, dead}}}}
+	DCE(f)
+	if load.Op != ssa.OpLoad32 || addr.Op != ssa.OpConst32 || dead.Op != ssa.OpInvalid {
+		t.Fatal("trapping load/address must survive, ordinary dead value must not")
+	}
+}
