+package codegen
+
+import (
+	"github.com/goccy/wasm2go/internal/ssa"
+	"github.com/goccy/wasm2go/internal/ssa/pass"
+	"github.com/goccy/wasm2go/internal/wasm"
+	"testing"
+)
+
+func TestPureMemory32RetainsIndividualStores(t *testing.T) {
+	f := &ssa.Func{}
+	b := &ssa.Block{Kind: ssa.BlockPlain}
+	f.Blocks = []*ssa.Block{b}
+	next := ssa.ValueID(0)
+	value := func(op ssa.Op, typ ssa.Type, args ...*ssa.Value) *ssa.Value {
+		next++
+		v := &ssa.Value{ID: next, Op: op, Type: typ, Args: args, Block: b}
+		b.Values = append(b.Values, v)
+		return v
+	}
+	root := value(ssa.OpParam, ssa.TypeI32)
+	w := value(ssa.OpParam, ssa.TypeV128)
+	bits := value(ssa.OpSimdCall, ssa.TypeI64, w)
+	bits.Aux = "simd_f16x4_cvt_bits"
+	c32 := value(ssa.OpConst64, ssa.TypeI64)
+	c32.AuxInt = 32
+	c16 := value(ssa.OpConst32, ssa.TypeI32)
+	c16.AuxInt = 16
+	stores := []*ssa.Value{}
+	for lane := 0; lane < 4; lane++ {
+		word := bits
+		if lane >= 2 {
+			word = value(ssa.OpShrU64, ssa.TypeI64, word, c32)
+		}
+		part := value(ssa.OpTrunc64To32, ssa.TypeI32, word)
+		if lane%2 != 0 {
+			part = value(ssa.OpShrU32, ssa.TypeI32, part, c16)
+		}
+		store := value(ssa.OpStore16, ssa.TypeMem, root, part)
+		store.AuxInt = int64(lane * 2)
+		stores = append(stores, store)
+	}
+	translator := &translator{mod: &wasm.Module{}, opts: Options{PureOnly: true}}
+	if translator.mergeF16Stores(f) {
+		t.Fatal("pure memory32 merged stores that can partially write before trapping")
+	}
+	for lane, store := range stores {
+		if store.Op != ssa.OpStore16 || store.AuxInt != int64(lane*2) {
+			t.Fatal("original store order/width/offset changed")
+		}
+	}
+	// Positive control: this is a real merging opportunity, not an inert fixture.
+	if !pass.MergeF16Stores(f) {
+		t.Fatal("fixture did not exercise the store merge")
+	}
+	count := 0
+	for _, v := range b.Values {
+		if v.Op == ssa.OpStore64 {
+			count++
+		}
+	}
+	if count != 1 {
+		t.Fatal("unchecked positive control did not merge four stores into one")
+	}
+}
