      "void",
      "buf_LRU_stat_update()",
      "{",
      "\tbuf_LRU_stat_t*\titem;",
      "\tbuf_LRU_stat_t\tcur_stat;",
      "",
      "\tif (!buf_pool.freed_page_clock) {",
      "\t\tgoto func_exit;",
      "\t}",
      "",
      "\t/* Update the index. */",
      "\titem = &buf_LRU_stat_arr[buf_LRU_stat_arr_ind];",
      "\tbuf_LRU_stat_arr_ind++;",
      "\tbuf_LRU_stat_arr_ind %= BUF_LRU_STAT_N_INTERVAL;",
      "",
      "\t/* Add the current value and subtract the obsolete entry.",
      "\tSince buf_LRU_stat_cur is not protected by any mutex,",
      "\tit can be changing between adding to buf_LRU_stat_sum",
      "\tand copying to item. Assign it to local variables to make",
      "\tsure the same value assign to the buf_LRU_stat_sum",
      "\tand item */",
      "\tcur_stat = buf_LRU_stat_cur;",
      "",
      "\tbuf_LRU_stat_sum.io += cur_stat.io - item->io;",
      "\tbuf_LRU_stat_sum.unzip += cur_stat.unzip - item->unzip;",
      "",
      "\t/* Put current entry in the array. */",
      "\tmemcpy(item, &cur_stat, sizeof *item);",
      "",
      "func_exit:",
      "\t/* Clear the current entry. */",
      "\tmemset(&buf_LRU_stat_cur, 0, sizeof buf_LRU_stat_cur);",
      "}"
    ],
