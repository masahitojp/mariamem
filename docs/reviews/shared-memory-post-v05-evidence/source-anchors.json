      "  for (auto &rseg : trx_sys.rseg_array)",
      "    if (rseg.space)",
      "    {",
      "      ut_ad(rseg.is_persistent());",
      "      log_free_check();",
      "      rseg.latch.wr_lock(SRW_LOCK_CALL);",
      "      dberr_t err= free_history_rseg(rseg);",
      "      rseg.latch.wr_unlock();",
      "      if (err)",
      "        return err;",
      "    }",
      "  return DB_SUCCESS;"
    ],
