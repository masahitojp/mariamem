    "lines": [
      "meaning that it is not in danger of getting evicted and also implying",
      "that it has been accessed recently.",
      "The page must be either buffer-fixed, or its page hash must be locked.",
      "@param[in]\tbpage\t\tbuffer pool page",
      "@return whether bpage is close to MRU end of LRU */",
      "inline bool buf_page_peek_if_young(const buf_page_t *bpage)",
      "{",
      "\t/* FIXME: bpage->freed_page_clock is 31 bits */",
      "\treturn((buf_pool.freed_page_clock & ((1UL << 31) - 1))",
      "\t       < (bpage->freed_page_clock",
      "\t\t  + (buf_pool.curr_size()",
      "\t\t     * (BUF_LRU_OLD_RATIO_DIV - buf_pool.LRU_old_ratio)",
      "\t\t     / (BUF_LRU_OLD_RATIO_DIV * 4))));",
      "}",
      "",
      "/** Determine if a block should be moved to the start of the LRU list if",
      "there is danger of dropping from the buffer pool.",
      "@param[in]\tbpage\t\tbuffer pool page",
      "@return true if bpage should be made younger */",
      "inline bool buf_page_peek_if_too_old(const buf_page_t *bpage)",
      "{",
      "\tif (buf_pool.freed_page_clock == 0) {",
      "\t\t/* If eviction has not started yet, do not update the",
      "\t\tstatistics or move blocks in the LRU list.  This is",
      "\t\teither the warm-up phase or an in-memory workload. */",
      "\t\treturn(FALSE);",
      "\t} else if (buf_LRU_old_threshold_ms && bpage->old) {",
      "\t\tuint32_t access_time = bpage->is_accessed();",
      "",
      "\t\t/* It is possible that the below comparison returns an",
      "\t\tunexpected result. 2^32 milliseconds pass in about 50 days,",
      "\t\tso if the difference between ut_time_ms() and access_time",
      "\t\tis e.g. 50 days + 15 ms, then the below will behave as if",
      "\t\tit is 15 ms. This is known and fixing it would require to",
      "\t\tincrease buf_page_t::access_time from 32 to 64 bits. */",
      "\t\tif (access_time",
      "\t\t    && ((ib_uint32_t) (ut_time_ms() - access_time))",
      "\t\t    >= buf_LRU_old_threshold_ms) {",
      "\t\t\treturn(TRUE);",
      "\t\t}",
      "",
      "\t\tbuf_pool.stat.n_pages_not_made_young++;",
      "\t\treturn false;",
      "\t} else {",
      "\t\treturn !buf_page_peek_if_young(bpage);",
      "\t}",
      "}"
    ],
