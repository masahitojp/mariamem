@@ -1479,0 +1487,68 @@
+
+#ifdef __wasi__
+extern "C" void *mariamem_stmt_parameter_items(MYSQL_STMT *);
+
+/* An independent MYSQL_RES owns all copied parameter descriptors. Reuse the
+   embedded protocol's Item -> MYSQL_FIELD conversion (including charset/flags),
+   without dispatching SQL, appending a result, or changing execution bindings. */
+extern "C" MYSQL_RES *mariamem_stmt_parameter_metadata(MYSQL_STMT *stmt)
+{
+  MYSQL *mysql= stmt->mysql;
+  THD *thd= static_cast<THD *>(mysql->thd);
+  if (!thd || mysql->status != MYSQL_STATUS_READY)
+    return NULL;
+  List<Item> *items= static_cast<List<Item> *>(mariamem_stmt_parameter_items(stmt));
+  if (!items || items->elements != stmt->param_count)
+    return NULL;
+  MYSQL_RES *result= static_cast<MYSQL_RES *>(my_malloc(
+      PSI_NOT_INSTRUMENTED, sizeof(MYSQL_RES), MYF(MY_WME | MY_ZEROFILL)));
+  if (!result)
+    return NULL;
+  MYSQL_DATA data= {};
+  EQR info= {};
+  data.embedded_info= &info;
+  init_alloc_root(PSI_NOT_INSTRUMENTED, &data.alloc, 8192, 0, MYF(0));
+  info.fields_list= static_cast<MYSQL_FIELD *>(alloc_root(
+      &data.alloc, sizeof(MYSQL_FIELD) * items->elements));
+  bool failed= !info.fields_list;
+  if (!failed)
+  {
+    bzero(info.fields_list, sizeof(MYSQL_FIELD) * items->elements);
+    THD *previous_thd= current_thd;
+    MYSQL_DATA *previous_data= thd->cur_data;
+    /* Formatting only: do not dock/undock the SQL worker or alter its
+       stack/mysys/kill state as store_globals/reset_globals would. */
+    set_current_thd(thd);
+    thd->cur_data= &data;
+    {
+      Protocol_text protocol(thd);
+      List_iterator_fast<Item> it(*items);
+      Item *item;
+      uint pos= 0;
+      while ((item= it++))
+      {
+        if (protocol.store_item_metadata(thd, item, pos++) ||
+            !info.fields_list[pos-1].catalog)
+        {
+          failed= true;
+          break;
+        }
+      }
+    }
+    thd->cur_data= previous_data;
+    set_current_thd(previous_thd);
+  }
+  if (failed)
+  {
+    free_root(&data.alloc, MYF(0));
+    my_free(result);
+    return NULL;
+  }
+  result->methods= mysql->methods;
+  result->eof= 1;
+  result->fields= info.fields_list;
+  result->field_count= items->elements;
+  result->field_alloc= data.alloc;
+  return result;
+}
+#endif
