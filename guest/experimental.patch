@@ -0,0 +1,91 @@
+/* Experimental import-only counters; no cache or destination change. */
+#include <time.h>
+#include <stdint.h>
+#include <unistd.h>
+#ifdef __wasm__
+typedef struct { unsigned char *buf; uint32_t len; } rr_iov;
+__attribute__((__import_module__("wasi_snapshot_preview1"), __import_name__("fd_read")))
+extern uint16_t rr_wasi_read(uint32_t, const rr_iov *, uint32_t, uint32_t *);
+#endif
+#ifndef RR_NATIVE_READ
+#define RR_NATIVE_READ read
+#endif
+static struct {
+  int active, measure, direct, process_ok, thread_ok;
+  uint64_t bytes, written_bytes, files, reads, writes;
+  uint64_t read_wall, read_process, read_thread, write_wall, write_process, write_thread;
+  uint64_t begin_wall, begin_process, begin_thread, wall, process, thread;
+} rr;
+static int rr_guest_process_ok=1, rr_guest_thread_ok=1;
+static uint64_t rr_guest_process, rr_guest_thread;
+static uint64_t rr_clock(clockid_t clock, int *ok)
+{
+  struct timespec ts;
+  if(clock_gettime(clock,&ts)) { *ok=0; return 0; }
+  return (uint64_t)ts.tv_sec*1000000000ULL+ts.tv_nsec;
+}
+static uint64_t rr_wall(void) { int ok=1; return rr_clock(CLOCK_MONOTONIC,&ok); }
+static void rr_guest_begin(void)
+{
+  rr_guest_process=rr_clock(CLOCK_PROCESS_CPUTIME_ID,&rr_guest_process_ok);
+  rr_guest_thread=rr_clock(CLOCK_THREAD_CPUTIME_ID,&rr_guest_thread_ok);
+}
+static int rr_begin(void)
+{
+  const char *mode=getenv("MARIAMEM_EXPERIMENT_RESTORE");
+  if(mode && strcmp(mode,"stdio") && strcmp(mode,"direct")) {
+    fputs("invalid experimental restore reader\n",stderr);return -1;
+  }
+  memset(&rr,0,sizeof(rr));rr.active=1;rr.measure=startup_timing.enabled;
+  rr.direct=mode && !strcmp(mode,"direct");rr.process_ok=rr.thread_ok=1;
+  rr.begin_wall=rr_wall();rr.begin_process=rr_clock(CLOCK_PROCESS_CPUTIME_ID,&rr.process_ok);
+  rr.begin_thread=rr_clock(CLOCK_THREAD_CPUTIME_ID,&rr.thread_ok);
+  return 0;
+}
+static void rr_end(void)
+{
+  rr.wall=rr_wall()-rr.begin_wall;
+  rr.process=rr_clock(CLOCK_PROCESS_CPUTIME_ID,&rr.process_ok)-rr.begin_process;
+  rr.thread=rr_clock(CLOCK_THREAD_CPUTIME_ID,&rr.thread_ok)-rr.begin_thread;
+  rr.active=0;
+}
+static ssize_t rr_source_read(FILE *in, unsigned char *buffer, size_t size)
+{
+  if(!rr.active || !rr.direct) return (ssize_t)fread(buffer,1,size,in);
+  for(;;) {
+#ifdef __wasm__
+    rr_iov iov={buffer,(uint32_t)size};uint32_t got=0;
+    uint16_t error=rr_wasi_read((uint32_t)fileno(in),&iov,1,&got);
+    if(error==27) continue; /* WASI ERRNO_INTR; retry without discarding bytes. */
+    if(error) {fprintf(stderr,"experimental restore fd_read failed: WASI errno=%u\n",error);return -1;}
+    return (ssize_t)got;
+#else
+    ssize_t n=RR_NATIVE_READ(fileno(in),buffer,size);
+    if(n<0 && errno==EINTR) continue;
+    return n;
+#endif
+  }
+}
+static void rr_json_cpu(FILE *f,const char *name,uint64_t value,int ok)
+{
+  fprintf(f,",\"%s\":",name);
+  if(ok)fprintf(f,"%llu",(unsigned long long)value);else fputs("null",f);
+}
+static void rr_write_stats(FILE *f)
+{
+  fprintf(f,",\"restore_copy\":{\"mode\":\"%s\",\"chunk_bytes\":65536,\"bytes\":%llu,\"written_bytes\":%llu,\"files\":%llu,\"read_calls\":%llu,\"write_calls\":%llu,\"total_wall_ns\":%llu,\"read_wall_ns\":%llu,\"write_wall_ns\":%llu",
+    rr.direct?"direct":"stdio",(unsigned long long)rr.bytes,(unsigned long long)rr.written_bytes,
+    (unsigned long long)rr.files,(unsigned long long)rr.reads,(unsigned long long)rr.writes,
+    (unsigned long long)rr.wall,(unsigned long long)rr.read_wall,(unsigned long long)rr.write_wall);
+  rr_json_cpu(f,"total_process_cpu_ns",rr.process,rr.process_ok);
+  rr_json_cpu(f,"total_thread_cpu_ns",rr.thread,rr.thread_ok);
+  rr_json_cpu(f,"read_process_cpu_ns",rr.read_process,rr.process_ok);
+  rr_json_cpu(f,"read_thread_cpu_ns",rr.read_thread,rr.thread_ok);
+  rr_json_cpu(f,"write_process_cpu_ns",rr.write_process,rr.process_ok);
+  rr_json_cpu(f,"write_thread_cpu_ns",rr.write_thread,rr.thread_ok);
+  uint64_t p=rr_clock(CLOCK_PROCESS_CPUTIME_ID,&rr_guest_process_ok)-rr_guest_process;
+  uint64_t t=rr_clock(CLOCK_THREAD_CPUTIME_ID,&rr_guest_thread_ok)-rr_guest_thread;
+  rr_json_cpu(f,"guest_main_to_ready_process_cpu_ns",p,rr_guest_process_ok);
+  rr_json_cpu(f,"guest_main_to_ready_thread_cpu_ns",t,rr_guest_thread_ok);
+  fputs("}",f);
+}
