+/* A scoped caller must never consume an enclosing wait notification. */
+bool thread_pool_generic::wait_begin_if_needed()
+{
+  if (!tls_worker_data)
+    return false;
+  std::unique_lock<std::mutex> lk(m_mtx);
+  if (!tls_worker_data->is_executing_task() ||
+      tls_worker_data->is_long_task() || tls_worker_data->is_waiting())
+    return false;
+
+  tls_worker_data->m_state |= worker_data::WAITING;
+  m_waiting_task_count++;
+  try
+  {
+    maybe_wake_or_create_thread();
+  }
+  catch (...)
+  {
+    tls_worker_data->m_state &= ~worker_data::WAITING;
+    m_waiting_task_count--;
+    throw;
+  }
+  return true;
+}
